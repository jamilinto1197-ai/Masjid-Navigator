rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validTimestamp(value) {
      return value is int || value is string;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'location', 'bio', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'location', 'bio', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && data.location is string
        && data.location.size() <= 100
        && data.bio is string
        && data.bio.size() <= 180
        && validTimestamp(data.updatedAt);
    }

    function validPrayerFlags(prayers) {
      return prayers is map
        && prayers.keys().hasOnly(['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'])
        && prayers.keys().hasAll(['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'])
        && prayers.Fajr is bool
        && prayers.Dhuhr is bool
        && prayers.Asr is bool
        && prayers.Maghrib is bool
        && prayers.Isha is bool;
    }

    function validAlarmSettings(settings) {
      return settings is map
        && settings.keys().hasOnly([
          'prayers', 'tune', 'offset', 'suhoor', 'iftar',
          'ramadanOnly', 'suhoorOffset'
        ])
        && settings.keys().hasAll([
          'prayers', 'tune', 'offset', 'suhoor', 'iftar',
          'ramadanOnly', 'suhoorOffset'
        ])
        && validPrayerFlags(settings.prayers)
        && settings.tune in ['adhan', 'soft', 'beep']
        && (settings.offset is int || settings.offset is float)
        && settings.offset >= -60
        && settings.offset <= 60
        && settings.suhoor is bool
        && settings.iftar is bool
        && settings.ramadanOnly is bool
        && (settings.suhoorOffset is int || settings.suhoorOffset is float)
        && settings.suhoorOffset >= 1
        && settings.suhoorOffset <= 180;
    }

    // Mosque directory records are curated by trusted administrators.
    // Client apps may read listings, but must never create or alter them.
    match /mosques/{mosqueId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      // Authenticated members can read rooms only under a real directory entry.
      // Messages are immutable; authors can delete only their own messages.
      match /messages/{messageId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/mosques/$(mosqueId));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/mosques/$(mosqueId))
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }

      // Reports are write-only to ordinary members. Review them from a trusted
      // administrative environment; never expose other users' reports in-app.
      match /reports/{reportId} {
        allow get, list: if false;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['reporterUid', 'messageId', 'reason', 'createdAt'])
          && request.resource.data.keys().hasAll(['reporterUid', 'messageId', 'reason', 'createdAt'])
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.messageId is string
          && request.resource.data.messageId.size() > 0
          && request.resource.data.messageId.size() <= 128
          && request.resource.data.reason in ['Spam', 'Abuse or harassment', 'Misleading information', 'Other']
          && exists(/databases/$(database)/documents/mosques/$(mosqueId)/messages/$(request.resource.data.messageId))
          && get(/databases/$(database)/documents/mosques/$(mosqueId)/messages/$(request.resource.data.messageId)).data.authorUid != request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Each member can access and update only their own profile document.
    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create, update: if owns(userId) && validProfile(request.resource.data);
      allow delete: if false;
    }

    // Prayer/alarm preferences may be read and written by their owner only.
    match /userSettings/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['alarmSettings', 'updatedAt'])
        && request.resource.data.keys().hasAll(['alarmSettings', 'updatedAt'])
        && validTimestamp(request.resource.data.updatedAt)
        && validAlarmSettings(request.resource.data.alarmSettings);
      allow delete: if false;
    }

    // Deny every collection not deliberately exposed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
